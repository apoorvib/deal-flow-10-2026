# Copy to .env (gitignored) and fill in real values.

POSTGRES_USER=savy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=savy

# docker-compose builds DATABASE_URL for the web container from the values above.
# Set it yourself only when running the app outside Docker:
# DATABASE_URL=postgresql+psycopg2://savy:change-me@localhost:5432/savy

# Fernet key(s) for column-level encryption of raw_document_text.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: comma-separate keys, newest first. New writes use the first key;
# reads try every key.
SAVY_FIELD_ENCRYPTION_KEY=
