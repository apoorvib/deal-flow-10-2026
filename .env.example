# Backend environment. Copy to .env and fill in.
# .env is gitignored — never commit real keys.

# --- Required for app auth and ownership (Supabase PostgreSQL) ---
# Supabase Dashboard → Connect → Direct → Session pooler → URI.
# Use the exact URI shown (username/host/port are project-specific). Backend requires SSL.
# Keep server-only: never add this to a VITE_ frontend variable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Set to 1 when deployed behind HTTPS; leave 0 for localhost development.
COOKIE_SECURE=0
# Comma-separated browser origins allowed to send the session cookie.
APP_ORIGINS=http://localhost:5173
# Public frontend origin used when generating invite links.
APP_ORIGIN=http://localhost:5173
# Use production to require ADMIN_EMAILS for admin registration and sign-in links.
APP_ENV=development
# Comma-separated staff emails allowed to use the admin role in production.
ADMIN_EMAILS=

# --- Required for AI document parsing (Nicrron gateway) ---
NICRRON_API_KEY=

# --- Required for FINRA BrokerCheck license lookups (Solari) ---
SOLARI_API_KEY=

# --- Optional: each unlocks one integration. Missing keys degrade gracefully. ---
# PRISM tracing. NOTE: the DEALFLOW credit only redeems AFTER a first trace lands,
# so sign up, grab the key, send a trace, THEN redeem.
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=4bdcda53-e2da-4d7e-91e9-f9ce234c351b
PRISMTRACE_API_KEY=
# Roundtable debate venue. Create an agent at roundtable.bot under
# Settings -> Agents & keys -> Connect agent -> AI assistant -> Custom, then
# copy its one-time private agent key into the server environment.
ROUNDTABLE_API_URL=https://roundtable.bot
ROUNDTABLE_API_KEY=
# akta.pro entity corroboration. Without it, cached fixture responses are used.
AKTA_API_BASE_URL=https://api.akta.pro
AKTA_API_KEY=

# --- Behavior flags ---
# cached = every external call serves a fixture, so the demo runs with WiFi off.
# live   = attempt real calls, falling back to cache on any failure.
DEMO_MODE=cached

# Send document images to the model as image_url blocks. Vision is confirmed
# working on both openai/gpt-6-luna and anthropic/claude-sonnet-5 (see spec §6),
# so this should be 1. Left as an explicit flag because the code defaults it OFF
# and silently falls back to text-only — if document images stop being read,
# check this first.
VISION_ENABLED=1
